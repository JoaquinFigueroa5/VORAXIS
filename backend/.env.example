# Same contract as the root .env.example. Inside docker compose the root .env is
# injected, so this file is only for running the backend directly on the host.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spaceapps
DB_USER=spaceapps
DB_PASSWORD=change_this_password
DATABASE_URL=postgresql+psycopg://spaceapps:change_this_password@localhost:5432/spaceapps

REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE=analysis

MINIO_ENDPOINT=localhost:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=change_this_password
MINIO_BUCKET=spaceapps-data
MINIO_SECURE=false

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
FIRMS_API_KEY=
