# One entry point for Voraxis: the built frontend at /, the API under /api.
# SITE_ADDRESS is the public domain (Caddy gets the HTTPS certificate by itself),
# or ":80" to serve plain HTTP when testing locally.
# REDIRECT_HOSTS lists other names (www, the Azure address) that send visitors to
# PUBLIC_URL; the frontend calls the API on PUBLIC_URL only, so one name must win.

{$SITE_ADDRESS} {
	encode zstd gzip

	# API, interactive docs and the OpenAPI schema go to FastAPI.
	@api path /api/* /docs /docs/* /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Vite fingerprints these files: cache them for a year.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# React routes (/analisis/..., /explorar) fall back to the app shell.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$REDIRECT_HOSTS} {
	redir {$PUBLIC_URL}{uri} permanent
}
