# Voraxis in production. Copy to .env on the server (never commit the real one):
#   cp deploy/env.prod.example .env && nano .env
# Generate passwords with:  openssl rand -base64 24 | tr -d '/+='

# ---- public address
# Where people open the site. Used for the frontend build and CORS.
PUBLIC_URL=https://voraxis.earth
# What Caddy serves: the bare domain (HTTPS automatic) or ":80" for plain HTTP tests.
SITE_ADDRESS=voraxis.earth
# Other names that redirect to PUBLIC_URL, comma separated (each needs DNS pointing here).
REDIRECT_HOSTS=www.voraxis.earth, voraxis.mexicocentral.cloudapp.azure.com
HTTP_PORT=80
HTTPS_PORT=443

# ---- database (only reachable inside the compose network)
DB_HOST=database
DB_PORT=5432
DB_NAME=spaceapps
DB_USER=spaceapps
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://spaceapps:CHANGE_ME@database:5432/spaceapps

# ---- queue
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE=analysis

# ---- object storage (VersityGW on the VM disk)
MINIO_ENDPOINT=minio:9000
# Keep the user that created the bucket (minioadmin in development): restored
# objects record it as their owner. The password is what has to be strong.
MINIO_USER=minioadmin
MINIO_PASSWORD=CHANGE_ME
MINIO_BUCKET=spaceapps-data
MINIO_SECURE=false

# ---- backend
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
# Delete each downloaded .h5 once its COG is stored (they are 2-7 GB each).
KEEP_DOWNLOADED_GRANULES=false

# ---- NASA credentials: copy them from your local .env, by hand
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
FIRMS_API_KEY=

# ---- backups (deploy/backup.sh)
# SAS URL of a Blob *container* with read, write, create and list permissions, e.g.
# https://<account>.blob.core.windows.net/voraxis-backups?sv=...&sig=...
BACKUP_SAS_URL=
