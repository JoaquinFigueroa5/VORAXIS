# Database
DB_HOST=database
DB_PORT=5432
DB_NAME=spaceapps
DB_USER=spaceapps
DB_PASSWORD=change_this_password

DATABASE_URL=postgresql+psycopg://spaceapps:change_this_password@database:5432/spaceapps

# Redis / queue
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE=analysis

# Object storage (S3 API). In development the `minio` service runs VersityGW.
MINIO_ENDPOINT=minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=change_this_password
MINIO_BUCKET=spaceapps-data
MINIO_SECURE=false

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# NASA Earthdata Login. Searching the ASF catalogue works without it; DOWNLOADING
# granules (scripts/ingest_nisar.py ingest --product-id ...) requires it.
# Put real values in .env only, never in this file.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Auxiliary data
FIRMS_API_KEY=

# Frontend (Vite reads VITE_* at dev/build time)
VITE_API_URL=http://localhost:8000/api/v1
