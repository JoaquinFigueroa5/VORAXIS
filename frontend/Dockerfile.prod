# Production image: build the Vite app, then serve it with Caddy.
# Caddy also terminates HTTPS and proxies /api to the backend (deploy/Caddyfile).

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Must be absolute (src/observatory/lib.ts does `new URL(API_URL)`), e.g. https://voraxis.example/api/v1
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN test -n "$VITE_API_URL" && npm run build

FROM caddy:2.8-alpine
COPY --from=build /app/dist /srv
